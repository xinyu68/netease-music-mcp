{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "netease-music-mcp",
  "version": "0.3.0",
  "description": "使用自己的网易云账号，在电脑上通过 Codex 搜歌、播放歌单和控制音乐。",
  "author": { "name": "xinyu.wang" },
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "网易云音乐",
        "shortDescription": "在 Codex 中点歌和控制电脑音乐",
        "category": "Entertainment",
        "defaultPrompt": "播放我喜欢的音乐"
      }
    }
  }
}
